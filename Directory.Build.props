<Project>
  <!-- Shared settings for the library, tests and all samples. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Embed symbols so published single-file apps don't ship loose .pdb files. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!--
    NuGet: metadata shared by every package of this repository (the classic GCI wrapper now,
    a wrapper for the thread-safe GCI later). Nothing is packable unless a project opts in
    with <IsPackable>true</IsPackable> and sets its own PackageId and Description.
    Version: VersionPrefix + VersionSuffix, e.g. 0.1.0-alpha; override with -p:Version=…
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
    <Authors>gemstone-csharp contributors</Authors>
    <Copyright>Copyright (c) 2026 gemstone-csharp contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/feldti/gemstone-csharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/feldti/gemstone-csharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>gemstone;gemstone-s;smalltalk;gci;gembuilder;database;object-database</PackageTags>
    <!-- Source Link (built into the .NET SDK): the embedded PDBs point to the sources on GitHub. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Reproducible builds on build servers (GitHub Actions sets GITHUB_ACTIONS, most others CI). -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
