<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET 10 plus .NET Framework 4.8 (Windows x64 clients, e.g. existing WinForms applications). -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <!-- Required by the function pointers in GciNative and the fixed buffers in GciErrSType. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>GemStone.Gci</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- Linux and Windows clients; GemStone/S 64 Bit ships 64-bit client libraries only. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Numerics" />
    <PackageReference Include="System.Memory" Version="4.6.0" />
    <PackageReference Include="Portable.System.DateTimeOnly" Version="9.0.0" />
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GemStone.Gci.Tests" />
  </ItemGroup>

</Project>
